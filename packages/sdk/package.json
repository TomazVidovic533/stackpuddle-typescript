{
  "name": "@stackpuddle/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Authoring SDK that emits the StackPuddle canonical project model.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "default": "./dist/postgres/index.js"
    },
    "./compose": {
      "types": "./dist/compose/index.d.ts",
      "default": "./dist/compose/index.js"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  }
}
